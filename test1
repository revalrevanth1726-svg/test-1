-- Complete client-side test harness for an Egg-tagged game.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local VirtualUser = game:GetService("VirtualUser")

local local_player = Players.LocalPlayer
local player_gui = local_player:WaitForChild("PlayerGui")

local camera = workspace.CurrentCamera

local state = {
    menu_open = true,

    speed = false,
    speed_value = 80,

    jump = false,
    jump_power = 110,

    infinite_jump = false,
    fly = false,
    fly_speed = 75,
    noclip = false,

    egg_esp = false,
    player_esp = false,

    nearest_egg_teleport = false,
    auto_target = false,
    auto_return = false,

    anti_afk = true,

    selected_egg = nil,
    selected_player = nil,
}

local saved_walk_speed = 16
local saved_jump_power = 50

local movement_connection
local noclip_connection
local infinite_jump_connection
local anti_afk_connection

local egg_highlights = {}
local player_highlights = {}

local function get_character()
    return local_player.Character
end

local function get_humanoid()
    local character = get_character()
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function get_root()
    local character = get_character()
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function get_part_position(instance)
    if instance:IsA("BasePart") then
        return instance.Position
    end

    if instance:IsA("Model") then
        if instance.PrimaryPart then
            return instance.PrimaryPart.Position
        end

        local root = instance:FindFirstChild("HumanoidRootPart")
        if root and root:IsA("BasePart") then
            return root.Position
        end

        local first_part = instance:FindFirstChildWhichIsA("BasePart", true)
        if first_part then
            return first_part.Position
        end
    end

    return nil
end

local function get_target_part(instance)
    if instance:IsA("BasePart") then
        return instance
    end

    if instance:IsA("Model") then
        return instance.PrimaryPart
            or instance:FindFirstChild("HumanoidRootPart")
            or instance:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function set_speed(enabled)
    state.speed = enabled

    local humanoid = get_humanoid()
    if not humanoid then
        return
    end

    if enabled then
        saved_walk_speed = humanoid.WalkSpeed
        humanoid.WalkSpeed = state.speed_value
    else
        humanoid.WalkSpeed = saved_walk_speed
    end
end

local function set_jump(enabled)
    state.jump = enabled

    local humanoid = get_humanoid()
    if not humanoid then
        return
    end

    humanoid.UseJumpPower = true

    if enabled then
        saved_jump_power = humanoid.JumpPower
        humanoid.JumpPower = state.jump_power
    else
        humanoid.JumpPower = saved_jump_power
    end
end

local function set_noclip(enabled)
    state.noclip = enabled

    if noclip_connection then
        noclip_connection:Disconnect()
        noclip_connection = nil
    end

    if not enabled then
        return
    end

    noclip_connection = RunService.Stepped:Connect(function()
        local character = get_character()

        if not character then
            return
        end

        for _, instance in ipairs(character:GetDescendants()) do
            if instance:IsA("BasePart") then
                instance.CanCollide = false
            end
        end
    end)
end

local function set_infinite_jump(enabled)
    state.infinite_jump = enabled

    if infinite_jump_connection then
        infinite_jump_connection:Disconnect()
        infinite_jump_connection = nil
    end

    if not enabled then
        return
    end

    infinite_jump_connection = UserInputService.JumpRequest:Connect(function()
        local humanoid = get_humanoid()

        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
end

local function set_fly(enabled)
    state.fly = enabled

    if movement_connection then
        movement_connection:Disconnect()
        movement_connection = nil
    end

    local root = get_root()

    if not enabled or not root then
        return
    end

    movement_connection = RunService.RenderStepped:Connect(function()
        local current_root = get_root()

        if not current_root then
            return
        end

        local direction = Vector3.zero

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction += camera.CFrame.LookVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction -= camera.CFrame.LookVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction += camera.CFrame.RightVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction -= camera.CFrame.RightVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.yAxis
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            direction -= Vector3.yAxis
        end

        if direction.Magnitude > 0 then
            direction = direction.Unit
        end

        current_root.AssemblyLinearVelocity =
            direction * state.fly_speed
    end)
end

local function clear_egg_esp()
    for instance, highlight in pairs(egg_highlights) do
        if highlight then
            highlight:Destroy()
        end

        egg_highlights[instance] = nil
    end
end

local function refresh_egg_esp()
    clear_egg_esp()

    if not state.egg_esp then
        return
    end

    for _, egg in ipairs(CollectionService:GetTagged("Egg")) do
        if egg:IsDescendantOf(workspace) then
            local highlight = Instance.new("Highlight")
            highlight.Name = "EggHackESP"
            highlight.Adornee = egg
            highlight.FillTransparency = 0.45
            highlight.OutlineTransparency = 0
            highlight.Parent = egg

            egg_highlights[egg] = highlight
        end
    end
end

local function clear_player_esp()
    for player, highlight in pairs(player_highlights) do
        if highlight then
            highlight:Destroy()
        end

        player_highlights[player] = nil
    end
end

local function refresh_player_esp()
    clear_player_esp()

    if not state.player_esp then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= local_player and player.Character then
            local highlight = Instance.new("Highlight")
            highlight.Name = "PlayerHackESP"
            highlight.Adornee = player.Character
            highlight.FillTransparency = 0.55
            highlight.OutlineTransparency = 0
            highlight.Parent = player.Character

            player_highlights[player] = highlight
        end
    end
end

local function get_nearest_egg()
    local root = get_root()

    if not root then
        return nil
    end

    local nearest
    local nearest_distance = math.huge

    for _, egg in ipairs(CollectionService:GetTagged("Egg")) do
        local position = get_part_position(egg)

        if position then
            local distance = (position - root.Position).Magnitude

            if distance < nearest_distance then
                nearest = egg
                nearest_distance = distance
            end
        end
    end

    return nearest
end

local function get_nearest_player()
    local root = get_root()

    if not root then
        return nil
    end

    local nearest
    local nearest_distance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= local_player then
            local character = player.Character
            local target_root = character and character:FindFirstChild("HumanoidRootPart")

            if target_root then
                local distance = (target_root.Position - root.Position).Magnitude

                if distance < nearest_distance then
                    nearest = player
                    nearest_distance = distance
                end
            end
        end
    end

    return nearest
end

local function teleport_to(instance, offset)
    local root = get_root()
    local target_part = instance and get_target_part(instance)

    if not root or not target_part then
        return false
    end

    root.CFrame = target_part.CFrame + (offset or Vector3.new(0, 4, 0))
    return true
end

local function teleport_to_nearest_egg()
    local egg = get_nearest_egg()

    if egg then
        state.selected_egg = egg
        teleport_to(egg)
    end
end

local function teleport_to_nearest_player()
    local player = get_nearest_player()

    if player and player.Character then
        local target_root = player.Character:FindFirstChild("HumanoidRootPart")

        if target_root then
            local root = get_root()

            if root then
                root.CFrame = target_root.CFrame + Vector3.new(0, 3, 0)
            end
        end
    end
end

local function find_base()
    local possible_names = {
        "Base",
        "Home",
        "Plot",
        "PlayerBase",
        "Spawn",
    }

    for _, name in ipairs(possible_names) do
        local object = workspace:FindFirstChild(name, true)

        if object and get_target_part(object) then
            return object
        end
    end

    return nil
end

local function teleport_to_base()
    local base = find_base()

    if base then
        teleport_to(base, Vector3.new(0, 5, 0))
    end
end

local function get_selected_egg()
    if state.selected_egg and state.selected_egg.Parent then
        return state.selected_egg
    end

    state.selected_egg = get_nearest_egg()
    return state.selected_egg
end

local function start_auto_target()
    state.auto_target = true
    state.selected_egg = get_nearest_egg()
end

local function stop_auto_target()
    state.auto_target = false
    state.selected_egg = nil
end

local function run_auto_target()
    if not state.auto_target then
        return
    end

    local egg = get_selected_egg()

    if not egg then
        state.selected_egg = get_nearest_egg()
        egg = state.selected_egg
    end

    if not egg then
        return
    end

    local root = get_root()
    local position = get_part_position(egg)

    if root and position then
        local distance = (position - root.Position).Magnitude

        if distance > 12 then
            teleport_to(egg)
        end
    end
end

local function setup_anti_afk()
    if anti_afk_connection then
        anti_afk_connection:Disconnect()
        anti_afk_connection = nil
    end

    if not state.anti_afk then
        return
    end

    anti_afk_connection = local_player.Idled:Connect(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end

