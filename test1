local toggle_menu_button = Instance.new("TextButton")
toggle_menu_button.Name = "Toggle"
toggle_menu_button.Size = UDim2.fromOffset(100, 36)
toggle_menu_button.Position = UDim2.fromOffset(20, 60)
toggle_menu_button.Text = "MENU"
toggle_menu_button.TextScaled = true
toggle_menu_button.Parent = screen_gui

local toggle_corner = Instance.new("UICorner")
toggle_corner.CornerRadius = UDim.new(0, 8)
toggle_corner.Parent = toggle_menu_button

toggle_menu_button.Activated:Connect(function()
    state.menu_open = not state.menu_open
    main.Visible = state.menu_open
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end

    if input.KeyCode == Enum.KeyCode.RightShift then
        state.menu_open = not state.menu_open
        main.Visible = state.menu_open
    end

    if input.KeyCode == Enum.KeyCode.F1 then
        set_speed(not state.speed)
    end

    if input.KeyCode == Enum.KeyCode.F2 then
        set_noclip(not state.noclip)
    end

    if input.KeyCode == Enum.KeyCode.F3 then
        set_fly(not state.fly)
    end

    if input.KeyCode == Enum.KeyCode.F4 then
        state.egg_esp = not state.egg_esp
        refresh_egg_esp()
    end

    if input.KeyCode == Enum.KeyCode.F5 then
        teleport_to_nearest_egg()
    end

    if input.KeyCode == Enum.KeyCode.F6 then
        teleport_to_base()
    end
end)

RunService.Heartbeat:Connect(function()
    run_auto_target()

    if state.speed then
        local humanoid = get_humanoid()

        if humanoid and humanoid.WalkSpeed ~= state.speed_value then
            humanoid.WalkSpeed = state.speed_value
        end
    end

    if state.jump then
        local humanoid = get_humanoid()

        if humanoid and humanoid.JumpPower ~= state.jump_power then
            humanoid.JumpPower = state.jump_power
        end
    end
end)

CollectionService:GetInstanceAddedSignal("Egg"):Connect(function()
    if state.egg_esp then
        refresh_egg_esp()
    end
end)

CollectionService:GetInstanceRemovedSignal("Egg"):Connect(function(removed)
    if state.selected_egg == removed then
        state.selected_egg = nil
    end

    if state.egg_esp then
        refresh_egg_esp()
    end
end)

Players.PlayerAdded:Connect(function()
    task.wait(0.5)

    if state.player_esp then
        refresh_player_esp()
    end
end)

Players.PlayerRemoving:Connect(function(player)
    local highlight = player_highlights[player]

    if highlight then
        highlight:Destroy()
    end

    player_highlights[player] = nil
end)

local_player.CharacterAdded:Connect(function()
    task.wait(0.5)

    local humanoid = get_humanoid()

    if humanoid then
        humanoid.UseJumpPower = true

        if state.speed then
            humanoid.WalkSpeed = state.speed_value
        end

        if state.jump then
            humanoid.JumpPower = state.jump_power
        end
    end

    if state.fly then
        set_fly(false)
        task.wait()
        set_fly(true)
    end

    if state.egg_esp then
        refresh_egg_esp()
    end

    if state.player_esp then
        refresh_player_esp()
    end
end)

setup_anti_afk()
refresh_egg_esp()
refresh_player_esp()
