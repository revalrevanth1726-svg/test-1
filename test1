----------------------------------------------------------------
-- ORE FOLDER
----------------------------------------------------------------

local function get_ore_folder()
	local folder = workspace:FindFirstChild(CONFIG.ore_folder_name)

	if not folder then
		folder = Instance.new("Folder")
		folder.Name = CONFIG.ore_folder_name
		folder.Parent = workspace
	end

	return folder
end

----------------------------------------------------------------
-- ORE CREATION
----------------------------------------------------------------

local function random_ore_position()
	local root = get_root()

	if not root then
		return Vector3.new(0, 5, 0)
	end

	local angle = math.random() * math.pi * 2
	local radius = math.random(15, CONFIG.ore_spawn_radius)

	local x = math.cos(angle) * radius
	local z = math.sin(angle) * radius

	return root.Position + Vector3.new(x, 3, z)
end

local function create_ore(ore_type, position)
	local part = Instance.new("Part")

	part.Name = ore_type
	part.Size = Vector3.new(4, 4, 4)
	part.Anchored = true
	part.CanCollide = true
	part.Position = position

	part.Material = Enum.Material.Slate

	local color_map = {
		Coal = Color3.fromRGB(35, 35, 35),
		Iron = Color3.fromRGB(145, 145, 145),
		Gold = Color3.fromRGB(255, 205, 50),
		Ruby = Color3.fromRGB(210, 30, 60),
		Diamond = Color3.fromRGB(80, 220, 255),
		Emerald = Color3.fromRGB(50, 220, 100),
		Obsidian = Color3.fromRGB(55, 20, 90),
	}

	part.Color = color_map[ore_type] or Color3.fromRGB(180, 180, 180)

	local tag = Instance.new("StringValue")
	tag.Name = "OreType"
	tag.Value = ore_type
	tag.Parent = part

	CollectionService:AddTag(part, "DebugOre")

	part.Parent = get_ore_folder()

	return part
end

local function spawn_ores(amount)
	amount = amount or CONFIG.ore_spawn_count

	local folder = get_ore_folder()

	for i = 1, amount do
		local ore_type = CONFIG.ore_types[
			math.random(1, #CONFIG.ore_types)
		]

		create_ore(ore_type, random_ore_position())
	end

	log("Spawned", amount, "debug ores")
end

local function clear_ores()
	local folder = workspace:FindFirstChild(CONFIG.ore_folder_name)

	if folder then
		folder:ClearAllChildren()
	end

	log("Cleared debug ores")
end

----------------------------------------------------------------
-- ORE ESP
----------------------------------------------------------------

local function clear_ore_esp()
	for ore, highlight in pairs(ore_highlights) do
		if highlight then
			highlight:Destroy()
		end

		ore_highlights[ore] = nil
	end
end

local function refresh_ore_esp()
	clear_ore_esp()

	if not state.ore_esp then
		return
	end

	for _, ore in ipairs(CollectionService:GetTagged("DebugOre")) do
		if ore:IsA("BasePart") then
			local highlight = Instance.new("Highlight")

			highlight.Name = "DebugOreESP"
			highlight.Adornee = ore
			highlight.FillTransparency = 0.45
			highlight.OutlineTransparency = 0

			highlight.Parent = ore

			ore_highlights[ore] = highlight
		end
	end
end

----------------------------------------------------------------
-- NEAREST ORE
----------------------------------------------------------------

local function get_nearest_ore()
	local root = get_root()

	if not root then
		return nil
	end

	local closest
	local closest_distance = math.huge

	for _, ore in ipairs(CollectionService:GetTagged("DebugOre")) do
		if ore:IsA("BasePart") and ore.Parent then
			local distance = (ore.Position - root.Position).Magnitude

			if distance < closest_distance then
				closest = ore
				closest_distance = distance
			end
		end
	end

	return closest
end

----------------------------------------------------------------
-- TELEPORT
----------------------------------------------------------------

local function teleport_to_ore()
	local root = get_root()
	local ore = get_nearest_ore()

	if not root or not ore then
		log("No ore found")
		return
	end

	root.CFrame = ore.CFrame + Vector3.new(0, 5, 0)

	log("Teleported to", ore.Name)
end

----------------------------------------------------------------
-- AUTO COLLECT
----------------------------------------------------------------

local function collect_ore(ore)
	if not ore or not ore.Parent then
		return
	end

	local ore_type = ore:FindFirstChild("OreType")

	if not ore_type then
		return
	end

	log("Collected debug ore:", ore_type.Value)

	ore:Destroy()
end

local function set_auto_collect(enabled)
	state.auto_collect = enabled

	if auto_collect_connection then
		auto_collect_connection:Disconnect()
		auto_collect_connection = nil
	end

	if not enabled then
		return
	end

	auto_collect_connection = RunService.Heartbeat:Connect(function()
		local root = get_root()

		if not root then
			return
		end

		local ore = get_nearest_ore()

		if not ore then
			return
		end

		local distance = (ore.Position - root.Position).Magnitude

		if distance < 10 then
			collect_ore(ore)
		end
	end)
end

----------------------------------------------------------------
-- MOVEMENT
----------------------------------------------------------------

local function set_speed(enabled)
	state.speed = enabled

	local humanoid = get_humanoid()

	if not humanoid then
		return
	end

	if enabled then
		original_walk_speed = humanoid.WalkSpeed
		humanoid.WalkSpeed = CONFIG.speed_value
	else
		humanoid.WalkSpeed = original_walk_speed
	end
end

local function set_jump(enabled)
	state.jump = enabled

	local humanoid = get_humanoid()

	if not humanoid then
		return
	end

	humanoid.UseJumpPower = true

	if enabled then
		original_jump_power = humanoid.JumpPower
		humanoid.JumpPower = CONFIG.jump_value
	else
		humanoid.JumpPower = original_jump_power
	end
end

local function set_noclip(enabled)
	state.noclip = enabled

	if noclip_connection then
		noclip_connection:Disconnect()
		noclip_connection = nil
	end

	if not enabled then
		return
	end

	noclip_connection = RunService.Stepped:Connect(function()
		local character = get_character()

		if not character then
			return
		end

		for _, object in ipairs(character:GetDescendants()) do
			if object:IsA("BasePart") then
				object.CanCollide = false
			end
		end
	end)
end

local function set_fly(enabled)
	state.fly = enabled

	if fly_connection then
		fly_connection:Disconnect()
		fly_connection = nil
	end

	if not enabled then
		local root = get_root()

		if root then
			root.AssemblyLinearVelocity = Vector3.zero
		end

		return
	end

	fly_connection = RunService.RenderStepped:Connect(function()
		local root = get_root()

		if not root then
			return
		end

		local camera = workspace.CurrentCamera

		if not camera then
			return
		end

		local direction = Vector3.zero

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			direction += camera.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			direction -= camera.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			direction -= camera.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			direction += camera.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			direction += Vector3.yAxis
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			direction -= Vector3.yAxis
		end

		if direction.Magnitude > 0 then
			direction = direction.Unit
		end

		root.AssemblyLinearVelocity =
			direction * CONFIG.fly_speed
	end)
end

