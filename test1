-- language: Luau, file: PaidItemAuthorizationProbe.client.lua
-- target: your own Roblox staging place
-- Purpose: detect whether a client can invoke a paid-item grant path
-- without valid entitlement.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

print("================================================")
print("      PAID ITEM AUTHORIZATION PROBE")
print("Account:", player.Name)
print("UserId:", player.UserId)
print("================================================")

local candidates = {}

for _, object in ipairs(game:GetDescendants()) do
	if object:IsA("RemoteEvent") or object:IsA("RemoteFunction") then
		local name = string.lower(object.Name)

		local keywords = {
			"paid",
			"purchase",
			"product",
			"pass",
			"premium",
			"armor",
			"helmet",
			"genesis",
			"void",
			"grant",
			"reward",
			"item",
			"claim",
		}

		for _, keyword in ipairs(keywords) do
			if string.find(name, keyword, 1, true) then
				table.insert(candidates, object)
				break
			end
		end
	end
end

print("")
print("[PROBE] Candidate remotes:")

for index, remote in ipairs(candidates) do
	print(
		index,
		remote.ClassName,
		remote:GetFullName()
	)
end

print("")
print("[PROBE] No automatic grant attempt was made.")
print("[PROBE] Record the candidate remote names from your staging build.")
print("[PROBE] The server should reject every unauthenticated grant request.")
