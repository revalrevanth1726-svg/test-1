-- language: Luau, file: ServerScriptService/OwnerPaidItems.server.lua
-- target: Roblox Studio
-- Owner-only developer tool for testing paid items.

local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")

----------------------------------------------------------------
-- CONFIG
----------------------------------------------------------------

local ADMIN_USER_IDS = {
	123456789, -- replace with your Roblox UserId
}

local PAID_ITEMS = {
	Genesis = {
		display_name = "Astral Genesis: The Tri-Wyrm Set",
		template_name = "AstralGenesis",
	},

	Void = {
		display_name = "Void Dominator",
		template_name = "VoidDominator",
	},
}

----------------------------------------------------------------
-- SETUP
----------------------------------------------------------------

local item_folder = ServerStorage:FindFirstChild("PaidItems")

if not item_folder then
	item_folder = Instance.new("Folder")
	item_folder.Name = "PaidItems"
	item_folder.Parent = ServerStorage
end

local function is_admin(player)
	return table.find(ADMIN_USER_IDS, player.UserId) ~= nil
end

local function find_template(item_key)
	local data = PAID_ITEMS[item_key]

	if not data then
		return nil, "Unknown item"
	end

	local template = item_folder:FindFirstChild(data.template_name)

	if not template then
		return nil, ("Missing template: %s"):format(data.template_name)
	end

	return template, nil
end

local function remove_existing(player, template_name)
	local containers = {
		player:FindFirstChildOfClass("Backpack"),
		player.Character,
	}

	for _, container in ipairs(containers) do
		if not container then
			continue
		end

		for _, object in ipairs(container:GetChildren()) do
			if object.Name == template_name then
				object:Destroy()
			end
		end
	end
end

local function give_item(player, item_key)
	if not is_admin(player) then
		warn("[OWNER GRANT] Unauthorized:", player.Name)
		return
	end

	local data = PAID_ITEMS[item_key]

	if not data then
		warn("[OWNER GRANT] Unknown item:", item_key)
		return
	end

	local template, error_message = find_template(item_key)

	if not template then
		warn("[OWNER GRANT]", error_message)
		return
	end

	remove_existing(player, data.template_name)

	local clone = template:Clone()

	------------------------------------------------------------
	-- TOOL
	------------------------------------------------------------

	if clone:IsA("Tool") then
		local backpack = player:FindFirstChildOfClass("Backpack")

		if not backpack then
			clone:Destroy()
			return
		end

		clone.Parent = backpack

		print(
			("[OWNER GRANT] %s received %s")
				:format(player.Name, data.display_name)
		)

		return
	end

	------------------------------------------------------------
	-- ACCESSORY
	------------------------------------------------------------

	if clone:IsA("Accessory") then
		local character = player.Character

		if not character then
			clone:Destroy()
			return
		end

		local humanoid = character:FindFirstChildOfClass("Humanoid")

		if not humanoid then
			clone:Destroy()
			return
		end

		humanoid:AddAccessory(clone)

		print(
			("[OWNER GRANT] Equipped %s on %s")
				:format(data.display_name, player.Name)
		)

		return
	end

	------------------------------------------------------------
	-- MODEL / ARMOR SET
	------------------------------------------------------------

	local character = player.Character

	if not character then
		clone:Destroy()
		return
	end

	clone.Parent = character

	local root = character:FindFirstChild("HumanoidRootPart")

	if clone:IsA("Model") and root then
		clone:PivotTo(root.CFrame)
	end

	print(
		("[OWNER GRANT] Spawned %s for %s")
			:format(data.display_name, player.Name)
	)
end

local function remove_item(player, item_key)
	if not is_admin(player) then
		return
	end

	local data = PAID_ITEMS[item_key]

	if not data then
		return
	end

	local containers = {
		player:FindFirstChildOfClass("Backpack"),
		player.Character,
	}

	for _, container in ipairs(containers) do
		if not container then
			continue
		end

		for _, object in ipairs(container:GetChildren()) do
			if object.Name == data.template_name then
				object:Destroy()
			end
		end
	end

	print(
		("[OWNER GRANT] Removed %s from %s")
			:format(data.display_name, player.Name)
	)
end

----------------------------------------------------------------
-- CHAT COMMANDS
----------------------------------------------------------------

local function handle_command(player, message)
	if not is_admin(player) then
		return
	end

	local args = string.split(message, " ")
	local command = string.lower(args[1] or "")
	local item = string.lower(args[2] or "")

	if command == "!paid" then

		if item == "genesis" then
			give_item(player, "Genesis")

		elseif item == "void" then
			give_item(player, "Void")

		elseif item == "all" then
			give_item(player, "Genesis")
			give_item(player, "Void")

		else
			print("Paid commands:")
			print("!paid genesis")
			print("!paid void")
			print("!paid all")
		end

	elseif command == "!unpaid" then

		if item == "genesis" then
			remove_item(player, "Genesis")

		elseif item == "void" then
			remove_item(player, "Void")

		elseif item == "all" then
			remove_item(player, "Genesis")
			remove_item(player, "Void")
		end
	end
end

----------------------------------------------------------------
-- PLAYER HOOK
----------------------------------------------------------------

local function setup_player(player)
	player.Chatted:Connect(function(message)
		handle_command(player, message)
	end)

	if is_admin(player) then
		print("")
		print("========== OWNER TEST MODE ==========")
		print("Player:", player.Name)
		print("!paid genesis")
		print("!paid void")
		print("!paid all")
		print("!unpaid genesis")
		print("!unpaid void")
		print("!unpaid all")
		print("=====================================")
		print("")
	end
end

Players.PlayerAdded:Connect(setup_player)

for _, player in ipairs(Players:GetPlayers()) do
	setup_player(player)
end
