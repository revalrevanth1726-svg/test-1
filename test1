-- language: Luau, file: ServerScriptService/DebugController.server.lua
-- target: Roblox Studio
-- Own-place debug authority for movement, teleport, and egg testing.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local REMOTE_NAME = "EggDebugRemote"

local ADMINS = {
	[123456789] = true, -- replace with your UserId
}

local remote = ReplicatedStorage:FindFirstChild(REMOTE_NAME)

if not remote then
	remote = Instance.new("RemoteEvent")
	remote.Name = REMOTE_NAME
	remote.Parent = ReplicatedStorage
end

local function is_admin(player)
	return ADMINS[player.UserId] == true
end

local function get_character(player)
	return player.Character
end

local function get_root(player)
	local character = get_character(player)
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function get_humanoid(player)
	local character = get_character(player)
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function get_position(object)
	if object:IsA("BasePart") then
		return object.Position
	end

	if object:IsA("Model") then
		local primary = object.PrimaryPart
		if primary then
			return primary.Position
		end

		local part = object:FindFirstChildWhichIsA("BasePart", true)
		if part then
			return part.Position
		end
	end

	return nil
end

local function get_target_part(object)
	if object:IsA("BasePart") then
		return object
	end

	if object:IsA("Model") then
		return object.PrimaryPart
			or object:FindFirstChild("HumanoidRootPart")
			or object:FindFirstChildWhichIsA("BasePart", true)
	end

	return nil
end

local function nearest_egg(player)
	local root = get_root(player)

	if not root then
		return nil
	end

	local best
	local best_distance = math.huge

	for _, egg in ipairs(CollectionService:GetTagged("Egg")) do
		local position = get_position(egg)

		if position then
			local distance = (position - root.Position).Magnitude

			if distance < best_distance then
				best = egg
				best_distance = distance
			end
		end
	end

	return best
end

local function teleport_to_object(player, object, offset)
	local root = get_root(player)
	local target = object and get_target_part(object)

	if not root or not target then
		return false
	end

	root.CFrame = target.CFrame + (offset or Vector3.new(0, 4, 0))
	return true
end

local function set_movement(player, properties)
	local humanoid = get_humanoid(player)

	if not humanoid then
		return
	end

	if properties.walk_speed then
		humanoid.WalkSpeed = properties.walk_speed
	end

	if properties.jump_power then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = properties.jump_power
	end
end

local function handle_command(player, action, data)
	if not is_admin(player) then
		warn(("DEBUG DENIED: %s -> %s"):format(player.Name, tostring(action)))
		return
	end

	if action == "movement" then
		set_movement(player, data)

	elseif action == "teleport_egg" then
		local egg = nearest_egg(player)

		if egg then
			teleport_to_object(player, egg)
		end

	elseif action == "teleport_object" and typeof(data) == "Instance" then
		if data:IsDescendantOf(workspace) then
			teleport_to_object(player, data)
		end

	elseif action == "teleport_player" then
		local target_player = Players:FindFirstChild(data)

		if target_player and target_player.Character then
			local target_root = get_root(target_player)
			local root = get_root(player)

			if target_root and root then
				root.CFrame = target_root.CFrame + Vector3.new(0, 4, 0)
			end
		end

	elseif action == "debug_log" then
		print(("[EGG DEBUG] %s: %s"):format(
			player.Name,
			tostring(data)
		))

	elseif action == "test_egg" then
		local egg = data

		if typeof(egg) == "Instance"
			and egg:IsDescendantOf(workspace)
			and CollectionService:HasTag(egg, "Egg") then

			print(("[EGG DEBUG] Egg interaction test: %s -> %s")
				:format(player.Name, egg:GetFullName()))
		end
	end
end

remote.OnServerEvent:Connect(handle_command)

Players.PlayerAdded:Connect(function(player)
	if is_admin(player) then
		print("[EGG DEBUG] Admin connected:", player.Name)
	end
end)
