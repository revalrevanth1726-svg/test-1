local function make_button(label, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -8, 0, 35)
    button.Text = label
    button.TextScaled = true
    button.Parent = container

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = button

    button.Activated:Connect(function()
        callback(button)
    end)

    return button
end

local function toggle_button(label, getter, setter)
    local button

    button = make_button(label, function()
        local enabled = not getter()
        setter(enabled)
        button.Text = label .. (enabled and ": ON" or ": OFF")
    end)

    return button
end

toggle_button("Speed", function()
    return state.speed
end, set_speed)

toggle_button("High Jump", function()
    return state.jump
end, set_jump)

toggle_button("Infinite Jump", function()
    return state.infinite_jump
end, set_infinite_jump)

toggle_button("Fly", function()
    return state.fly
end, set_fly)

toggle_button("Noclip", function()
